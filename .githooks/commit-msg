#!/bin/sh
# Fashion Asia commit-name guard (docs/WORKFLOW.md §2). Enabled with:
#   git config core.hooksPath .githooks
# Owner ruling 2026-10-08: each GitHub repo shows only its own account. Local main is the
# client (happierbangladesh) history, so every local commit is authored and committed by
# happierbangladesh, and no commit carries a co-author line. The origin (AdilAhmedAhir) copy is
# made by .claude/scripts/mirror-authorship.mjs at deploy time.

msg_file="$1"
required="happierbangladesh <happierbangladesh@users.noreply.github.com>"

fail() {
  echo "commit-name guard: $1" >&2
  echo "  Rule: docs/WORKFLOW.md §2. Fix the commit rather than bypassing this hook." >&2
  exit 1
}

author=$(git var GIT_AUTHOR_IDENT | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')
committer=$(git var GIT_COMMITTER_IDENT | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')
[ "$author" = "$required" ] || fail "author is '$author', expected '$required'."
[ "$committer" = "$required" ] || fail "committer is '$committer', expected '$required'."

# Ignore comment lines, which git strips from the final message.
body=$(grep -v '^#' "$msg_file")
total=$(printf '%s\n' "$body" | grep -ci '^[[:space:]]*co-authored-by:')
[ "$total" -eq 0 ] || fail "remove the co-author line(s) (found $total): the account owner is the only author."
exit 0
