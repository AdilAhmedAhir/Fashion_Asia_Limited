{
  "$comment": "Fashion Asia: the existing allow and deny list (owner's choice: Bash(*) allowed), merged on 2026-09-28 with A-Team V7's ask list, .env read denies and hooks. Pushes and deploys ASK; force-push and .env reads are DENIED. Commit names are enforced separately by .githooks/ (git config core.hooksPath .githooks). GENESIS Phase 4 (2026-09-28): agents have no database access, so the Supabase CLI, psql, .mcp.json and the account's Supabase MCP connector (mcp__854b58fd-\u2026) are DENIED in this project.",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git show*)",
      "Bash(ls*)",
      "Bash(cat docs/*)",
      "Bash(grep*)",
      "Bash(find docs*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(php --version)",
      "Bash(python --version)",
      "Bash(go version)",
      "Bash(cargo --version)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(vercel*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .*)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat **/.env*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(supabase*)",
      "Bash(psql*)",
      "Write(./.mcp.json)",
      "Edit(./.mcp.json)",
      "mcp__854b58fd-0db4-4ce3-b3e1-a9debcae7667"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/path-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
